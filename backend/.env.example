# Required: Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key

# Required: Mem0 platform API key
MEM0_API_KEY=your-mem0-api-key

# Required: Secret key for signing JWT tokens (use a long random string)
JWT_SECRET=change-me-to-a-random-secret

# Optional: Directory that the read_file tool is allowed to access (default: user home)
ZEN_ALLOWED_READ_DIR=~/projects

# Optional: Enable/disable proactive nudge system (default: true)
NUDGE_ENABLED=true

# Optional: How many days back to look for nudge-worthy memories (default: 7)
NUDGE_LOOKBACK_DAYS=7
