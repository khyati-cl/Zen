# ──────────────────────────────────────────────────────────────
# Zen — Example Environment File
# ──────────────────────────────────────────────────────────────
# Copy this file to .env in the backend/ directory:
#
#   cp .env.example backend/.env
#
# The backend reads .env via python-dotenv (load_dotenv) at
# startup. The frontend has no runtime env vars — it connects
# to the backend at http://localhost:8000 by default.
#
# NEVER commit a filled-in .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────

# Google Gemini API key — powers the LLM chat responses.
# Obtain one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Mem0 platform API key — used for persistent user memory.
# Obtain one at: https://app.mem0.ai/ → Settings → API Keys
MEM0_API_KEY=your-mem0-api-key

# Secret for signing JWT authentication tokens.
# Must be a long random string (≥ 32 characters). Generate one:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# The server refuses to start without this.
JWT_SECRET=change-me-to-a-random-secret

# ── Optional ─────────────────────────────────────────────────

# Filesystem directory the read_file tool is allowed to access.
# Default: the current user's home directory (~).
# Set this to restrict or widen the sandbox.
ZEN_ALLOWED_READ_DIR=~/projects

# Enable or disable the proactive nudge system.
# Accepts: true | false | 1 | 0 | yes | no
# Default: true
NUDGE_ENABLED=true

# How many days back to scan for nudge-worthy memories.
# Default: 7
NUDGE_LOOKBACK_DAYS=7
